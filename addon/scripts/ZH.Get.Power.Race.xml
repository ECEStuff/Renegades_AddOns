					<sval type="string" val="$t = $ship + ' is class ' + $class + '. is a big ship? ' + $isBig + '; is huge? ' + $isHuge + '; is little? ' + $isLittle + '; is fighter? ' + $isFighter + '; is freighter? ' + $isFreighter" />
				</sval>
				<sval type="array" size="3">
					<sval type="int" val="13" />
					<sval type="int" val="1" />
