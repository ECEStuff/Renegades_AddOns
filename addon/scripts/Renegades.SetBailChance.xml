			<text> </text>
			<var>99</var>
		</line>
		<line linenr="010" indent="&#160;">
			<var>$trig</var>
			<text> </text>
			<text>=</text>
			<text> </text>
			<var>0</var>
		</line>
		<line linenr="011" indent="&#160;">
			<var>$owner</var>
			<text> </text>
			<text>=</text>
			<text> </text>
			<var>$ship</var>
			<text>-&gt;</text>
