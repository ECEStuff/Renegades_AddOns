		</line>
		<line linenr="057" indent="&#160;&#160;&#160;">
			<var>$trig</var>
			<text> </text>
			<text>=</text>
			<text> </text>
			<var>1</var>
		</line>
		<line linenr="058" indent="&#160;">
			<text>else</text>
			<text> </text>
			<text>if</text>
			<text> </text>
			<var>$ship</var>
			<text>-&gt;</text>
			<text> </text>
			<text>is</text>
			<text> </text>
			<text>of</text>
			<text> </text>
			<text>class</text>
