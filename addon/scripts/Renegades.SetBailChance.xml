			<text>/</text>
			<text> </text>
			<var>100</var>
		</line>
		<line linenr="045" indent="&#160;&#160;" />
		<line linenr="046" indent="&#160;&#160;">
			<comment>* teladi are cowards and bail more often.</comment>
		</line>
		<line linenr="047" indent="&#160;&#160;">
