		</line>
		<line linenr="074" indent="&#160;&#160;">
			<text>end</text>
		</line>
		<line linenr="075" indent="&#160;&#160;" />
		<line linenr="076" indent="&#160;&#160;">
			<comment>* Add-Ons 1.3: Insane mode halves the bail rate.</comment>
		</line>
		<line linenr="077" indent="&#160;&#160;">
			<text>do</text>
			<text> </text>
			<text>if</text>
			<text> </text>
			<var>$difficulty</var>
			<text> </text>
			<text>&gt;</text>
			<text> </text>
			<var>2</var>
		</line>
		<line linenr="078" indent="&#160;&#160;&#160;">
			<var>$trig</var>
			<text> </text>
			<text>=</text>
			<text> </text>
			<var>$trig</var>
			<text> </text>
			<text>/</text>
			<text> </text>
			<var>2</var>
		</line>
		<line linenr="079" indent="&#160;&#160;" />
		<line linenr="080" indent="&#160;&#160;">
			<comment>* Add-Ons 1.2: Kha'ak fighters can bail, but the chances are 1/5 as usual. This penalty does not apply to bigger Kha'ak ships due to their rarity.</comment>
		</line>
		<line linenr="081" indent="&#160;&#160;">
			<text>do</text>
			<text> </text>
			<text>if</text>
			<text> </text>
			<var>$owner</var>
			<text> </text>
			<text>==</text>
			<text> </text>
			<var>[Kha'ak]</var>
		</line>
		<line linenr="082" indent="&#160;&#160;&#160;">
			<var>$trig</var>
			<text> </text>
			<text>=</text>
			<text> </text>
			<var>$trig</var>
			<text> </text>
			<text>/</text>
			<text> </text>
			<var>5</var>
		</line>
		<line linenr="083" indent="&#160;&#160;" />
		<line linenr="084" indent="&#160;&#160;">
			<comment>* Enforce a minimum 1% chance to bail.</comment>
		</line>
		<line linenr="085" indent="&#160;&#160;">
			<text>do</text>
			<text> </text>
			<text>if</text>
			<text> </text>
			<var>$trig</var>
			<text> </text>
			<text>&lt;</text>
			<text> </text>
			<var>1</var>
		</line>
		<line linenr="086" indent="&#160;&#160;&#160;">
			<var>$trig</var>
