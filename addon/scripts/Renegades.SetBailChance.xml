			<text> </text>
			<text>:</text>
		</line>
		<line linenr="013" indent="&#160;">
			<var>$mult</var>
			<text> </text>
			<text>=</text>
			<text> </text>
			<text>get</text>
			<text> </text>
			<text>global</text>
			<text> </text>
			<text>variable</text>
