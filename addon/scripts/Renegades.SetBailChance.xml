		</line>
		<line linenr="066" indent="&#160;&#160;">
			<text>end</text>
		</line>
		<line linenr="067" indent="&#160;&#160;" />
		<line linenr="068" indent="&#160;&#160;">
			<comment>* Scale the bail chance based on global variable.</comment>
		</line>
		<line linenr="069" indent="&#160;&#160;">
			<var>$trig</var>
			<text> </text>
			<text>=</text>
			<text> </text>
			<text>(</text>
			<var>$trig</var>
			<text> </text>
			<text>*</text>
			<text> </text>
