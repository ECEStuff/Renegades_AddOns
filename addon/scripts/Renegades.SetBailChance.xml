		</line>
		<line linenr="006" indent="">
			<var>$WillBail</var>
			<text> </text>
			<text>=</text>
			<text> </text>
			<var>$ship</var>
			<text>-&gt;</text>
			<text> </text>
			<text>get</text>
			<text> </text>
			<text>local</text>
			<text> </text>
			<text>variable</text>
			<text>:</text>
			<text> </text>
