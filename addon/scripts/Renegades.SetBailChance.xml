			<text>is</text>
			<text> </text>
			<text>of</text>
			<text> </text>
			<text>class</text>
			<text> </text>
			<var>[TM]</var>
		</line>
		<line linenr="022" indent="&#160;&#160;">
			<var>$isTL</var>
