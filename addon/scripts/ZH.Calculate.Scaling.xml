			<text>'ZH_overextensionScaling'</text>
		</line>
		<line linenr="011" indent="" />
		<line linenr="012" indent="">
			<comment>* Will never be less than 100. Can be null upon initialization however.</comment>
		</line>
		<line linenr="013" indent="">
			<text>if</text>
			<text> </text>
			<var>$npcScaleFactor</var>
			<text> </text>
			<text>==</text>
			<text> </text>
			<var>null</var>
			<text> </text>
